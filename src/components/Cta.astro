---
import nastaveni from '../data/nastaveni.json';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Domluvme se na termínu',
  text = 'Zavolejte, napište e-mail, nebo vyplňte rezervační formulář. Ozvu se vám co nejdříve.',
} = Astro.props;
const tel = `tel:+420${nastaveni.telefon.replace(/\s/g, '')}`;
---
<section class="section">
  <div class="container">
    <div class="cta">
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="cta__actions">
        <a class="btn btn--primary" href="/kontakt#rezervace">Rezervovat termín</a>
        <a class="btn btn--ghost" href={tel}>Zavolat {nastaveni.telefon}</a>
      </div>
    </div>
  </div>
</section>
