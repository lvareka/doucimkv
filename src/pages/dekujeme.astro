---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Děkuji – zpráva odeslána | Doučování Karlovy Vary" description="Vaše zpráva byla odeslána." noindex={true}>
  <section class="section">
    <div class="container center" style="max-width:640px">
      <h1>Děkuji za zprávu!</h1>
      <p class="lead">Vaše zpráva byla úspěšně odeslána. Ozvu se vám co nejdříve.</p>
      <p>Mezitím se můžete podívat na <a href="/cenik">ceník</a> nebo na <a href="/forma">formu doučování</a>.</p>
      <a class="btn btn--primary" href="/">Zpět na úvod</a>
    </div>
  </section>
</BaseLayout>
